# Dependencies & build output (Vite + TS skeleton lands in H1)
node_modules/
dist/
builds/
.dev-server/
.playwright-smoke/
playwright-report/
test-results/
playwright-production-report/
test-results-production/
*.local

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json

# Raw/unprocessed asset sources (processed assets live in public/assets/ with manifest)
tools/raw-assets/

# Generated asset-library index — heavy, machine-specific, regenerable via
# `node tools/asset-library-index.mjs`. The grep-friendly TSV + human catalog
# are kept tracked; only the full JSON is ignored.
tools/*/[!.]*-index.json

# Open-world test world: regenerated by `npm run world:test`, ~100 MB of tiles.
public/layouts/OpenWorldTest.level.json
public/layouts/OpenWorldTest.landscapes/
# World Builder test valley (npm run world:valley)
public/layouts/WbTestValley.*
public/layouts/WbTestValley.landscapes/

# Ad-hoc Playwright reports and traces
/output/

# Blender numbered backups of the art/ masters
*.blend[0-9]*
# Baked vehicle atlases: the GLB carries them, their scripts remake them
art/vehicles/*/textures/
art/vehicles/*/__pycache__/
# World Builder pilot valley (npm run world:pilot)
public/layouts/WbPilotValley.*
public/layouts/WbPilotValley.landscapes/
