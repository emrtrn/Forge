{
  "name": "forge",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable Three.js game template with a built-in editor mode",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:smoke": "vite --host 127.0.0.1 --port 5273 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "editor": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "editor:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check:assets": "node tools/run-asset-manifest-health.mjs --baseline tools/baselines/asset-health.json",
    "perf:assets": "node tools/run-asset-perf-report.mjs",
    "perf:browser": "node tools/browser-perf-report.mjs",
    "perf:lake": "tsc --noEmit -p tools/perf/tsconfig.lake.json && node tools/lake-performance-report.mjs",
    "perf:quality": "node tools/quality-matrix-report.mjs",
    "audio:manifest": "node tools/sync-audio-manifest.mjs",
    "audio:loudness": "node tools/audit-audio-loudness.mjs",
    "audio:codecs": "node tools/probe-audio-codecs.mjs",
    "optimize:glb": "node tools/optimize-mesh-glb.mjs",
    "dialogue:report": "node tools/dialogue-report.mjs",
    "world:test": "node tools/world/generate-test-world.mjs",
    "world:valley": "node tools/world/generate-wb-test-valley.mjs",
    "world:offroad": "node tools/world/generate-offroad-test.mjs",
    "world:build": "node tools/world/build-hlod.mjs",
    "terrain:repair": "node tools/world/repair-terrain.mjs",
    "verify:dist": "node builder/web/verify-dist.mjs",
    "verify:world-data": "node tools/run-world-data-check.mjs",
    "verify:imports": "node --test tests/builder/verify-imports.test.mjs && node builder/web/verify-imports.mjs",
    "verify:smoke-fixtures": "tsc --noEmit -p tsconfig.smoke.json && node --test tests/builder/smoke-project.test.mjs",
    "verify:content-types": "tsc --noEmit -p tsconfig.content-tests.json",
    "verify:ui-test-types": "tsc --noEmit -p tsconfig.ui-tests.json",
    "verify:release-tools": "node --test tests/builder/public-url.test.mjs tests/builder/release-content.test.mjs",
    "build:release": "tsc --noEmit && npm run verify:release-tools && node builder/web/build-release.mjs",
    "test:engine": "node tools/run-engine-tests.mjs",
    "test:engine:slow": "node tools/run-engine-tests.mjs --slow",
    "smoke:browser": "playwright test",
    "smoke:critical": "playwright test boot-errors.spec.ts content-loading.spec.ts editor-authoring.spec.ts runtime-playflow.spec.ts runtime-checkpoint.spec.ts",
    "smoke:production": "playwright test --config playwright.production.config.ts",
    "build:verify": "npm run verify:imports && npm run verify:smoke-fixtures && npm run verify:content-types && npm run verify:ui-test-types && npm run verify:release-tools && npm run build && npm run test:engine:slow && npm run verify:dist -- --strict && npm run verify:world-data",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@recast-navigation/core": "0.43.1",
    "meshoptimizer": "^1.1.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.0",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.0",
    "lil-gui": "^0.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
